# Read-only VM image validator. This image is pinned by digest in the Res
# deployment (Service.ImageUpload.ValidatorImage) and the validation Job runs it
# with three fixed arguments only.
#
# util-linux is present for exactly one reason: the ISO signature check calls the
# fixed argv form `blkid -p -s TYPE -o value -- /source/disk.img` without a shell.
# Nothing else in the image is configurable by a caller, and the program itself
# cannot be given an image, a command, a mount path or a plugin.
#
# Build from the repository root, with the Go binary produced by the same pinned
# toolchain used for the service image:
#   docker build -f Dockerfile.verify -t <registry>/ani-vm-image-verify:<tag> .
FROM docker.changqingyun.cn/hub/library/alpine:3.22

RUN apk add --no-cache util-linux

COPY out/vm-image-verify /vm-image-verify

# The Job template forces runAsNonRoot with the CDI importer's uid/gid, which is the
# identity that may open the block device. No capability, no privilege, no writable
# root filesystem.
USER 107:107
ENTRYPOINT ["/vm-image-verify"]
