+		if disk == nil || strings.TrimSpace(disk.ClientDiskKey) == "" || len(disk.ClientDiskKey) > 128 || seen[disk.ClientDiskKey] || strings.TrimSpace(disk.Name) == "" || utf8.RuneCountInString(disk.Name) > 128 || !validSize(disk.SizeGb) {
