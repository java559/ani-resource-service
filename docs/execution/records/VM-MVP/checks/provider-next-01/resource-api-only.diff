+		return ErrInvalidRequest
+	}
+	if g == nil {
+		if c != nil {
+			return ErrInvalidRequest
+		}
+		return nil
+	}
+	password := ""
+	if c != nil {
+		password = c.Password
+	}
+	if !g.PasswordSet {
+		if password != "" {
+			return ErrInvalidRequest
+		}
+		return nil
+	}
+	if len(password) < 8 || len(password) > 128 || !utf8.ValidString(password) || strings.ContainsAny(password, "\x00\r\n") {
+		return ErrInvalidRequest
+	}
+	return nil
+}
+
+func validUUID(s string) bool {
+	u, e := uuid.Parse(s)
